# AutoForge environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- NVIDIA Nemotron via NIM (OpenAI-compatible endpoint) ---
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
COORDINATOR_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
WORKER_MODEL=nvidia/nvidia-nemotron-nano-9b-v2

# --- Strategy Agent web search ---
TAVILY_API_KEY=tvly-...

# --- HITL: Telegram bot ---
# Get a token from @BotFather; chat ID via @userinfobot or by inspecting an update.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Persistence ---
# SQLite path (relative to project root). Created on first init_db run.
AUTOFORGE_DB_PATH=./data/autoforge.db

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
